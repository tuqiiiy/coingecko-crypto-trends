{
  "title": "CoinGecko Crypto Scraper Input Schema",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "mode": {
      "title": "Extraction Mode",
      "type": "string",
      "description": "Choose between real-time trending coins or top market-cap tokens.",
      "editor": "select",
      "default": "trending",
      "enum": ["trending", "topMarkets"],
      "enumTitles": ["Trending Coins (Search Popularity)", "Top Market Cap Coins"]
    },
    "limit": {
      "title": "Limit (for Top Markets)",
      "type": "integer",
      "description": "Number of coins to extract (up to 100).",
      "minimum": 1,
      "maximum": 100,
      "default": 50
    },
    "proxyConfiguration": {
      "title": "Proxy Configuration",
      "type": "object",
      "description": "Optional proxy configuration.",
      "editor": "proxy"
    }
  },
  "required": []
}
